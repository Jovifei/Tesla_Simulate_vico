+function options = validateResearchOptions(options, identity, source)
+if ~isstruct(options) || ~isscalar(options) || ~isfield(options, "enabled") || ...
+        ~islogical(options.enabled) || ~isscalar(options.enabled)
+    error("S12:EngineSoundV12:ResearchOptions", "enabled must be a logical scalar.");
+end
+if ~options.enabled
+    return
+end
+required = ["cut_minimum", "whine_scale", "induction_scale", "voicing_rpm_band"];
+% Match the resolver's Hellcat source inference even when an explicit identity
+% is supplied, so another V8 source cannot enter this research path.
+isHellcatSource = source.engine_kind == "piston" && source.cylinders == 8 && ...
+    ~isempty(source.order_surface) && source.order_surface(1).order == 2;
+if identity.profile_id ~= "hellcat_2022_stock" || ~isHellcatSource || ~all(isfield(options, required))
+    error("S12:EngineSoundV12:ResearchOptions", ...
+        "Research controls require the Hellcat identity/source and all option fields.");
+end
+for field = ["cut_minimum", "whine_scale", "induction_scale"]
+    value = options.(field);
+    if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ~isfinite(value) || ...
+            value < 0 || value > 1
+        error("S12:EngineSoundV12:ResearchOptions", "%s must be a scalar in [0,1].", field);
+    end
+    options.(field) = double(value);
+end
+band = options.voicing_rpm_band;
+if ~isnumeric(band) || ~isreal(band) || ~isequal(size(band), [1, 2]) || ...
+        any(~isfinite(band)) || band(1) < 0 || band(2) > 12000 || band(1) >= band(2)
+    error("S12:EngineSoundV12:ResearchOptions", ...
+        "voicing_rpm_band must be a strictly increasing finite RPM row vector.");
+end
+options.voicing_rpm_band = double(band);
+end
