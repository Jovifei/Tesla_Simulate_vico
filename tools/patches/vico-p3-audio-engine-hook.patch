+package com.vico.simulator.sound
+
+internal interface C63QualificationPcmProvider {
+    val candidateId: String
+    val eligible: Boolean
+    fun render(state: SoundState, frames: Int): FloatArray?
+}
+
+internal class SafeC63QualificationProvider(
+    override val candidateId: String,
+    override val eligible: Boolean,
+    private val renderer: (SoundState, Int) -> FloatArray?,
+) : C63QualificationPcmProvider {
+    override fun render(state: SoundState, frames: Int): FloatArray? {
+        if (!eligible) return null
+        if (candidateId == "C63_HY1" || candidateId.startsWith("C63_HY1_")) return null
+        return runCatching { renderer(state, frames) }
+            .getOrNull()
+            ?.takeIf { it.size == frames && it.all { sample -> sample.isFinite() } }
+    }
+}
