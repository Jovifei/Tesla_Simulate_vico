{
  "schema": "s12.vehicle_state_packet.v0.1",
  "synthetic": true,
  "calibrated": false,
  "fields": {
    "timestamp": {
      "type": "number",
      "unit": "s",
      "range": [0, 1000000],
      "source_level": "C",
      "description": "synthetic monotonic packet timestamp"
    },
    "rpm": {
      "type": "number",
      "unit": "rpm",
      "range": [0, 8000],
      "source_level": "C",
      "description": "synthetic transport RPM; runtime synthesis safety range is 800 to 6000 rpm"
    },
    "speed": {
      "type": "number",
      "unit": "km/h",
      "range": [0, 300],
      "source_level": "C",
      "description": "synthetic vehicle speed converted to m/s before runtime"
    },
    "acceleration": {
      "type": "number",
      "unit": "m/s^2",
      "range": [-20, 20],
      "source_level": "C",
      "description": "synthetic longitudinal acceleration"
    },
    "load": {
      "type": "number",
      "unit": "fraction",
      "range": [0, 1],
      "source_level": "C",
      "description": "synthetic normalized engine load"
    },
    "throttle": {
      "type": "number",
      "unit": "fraction",
      "range": [0, 1],
      "source_level": "C",
      "description": "synthetic normalized throttle"
    }
  }
}
