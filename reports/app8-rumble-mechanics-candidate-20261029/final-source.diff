+function options = validateResearchOptions(options, identity, source)
+if ~isstruct(options) || ~isscalar(options) || ~isfield(options, "enabled") || ...
+        ~islogical(options.enabled) || ~isscalar(options.enabled)
+    error("S12:EngineSoundV12:ResearchOptions", "enabled must be a logical scalar.");
+end
+if ~options.enabled
+    return
+end
+required = ["cut_minimum", "whine_scale", "induction_scale", "voicing_rpm_band"];
+% Match the resolver's Hellcat source inference even when an explicit identity
+% is supplied, so another V8 source cannot enter this research path.
+isHellcatSource = source.engine_kind == "piston" && source.cylinders == 8 && ...
+    ~isempty(source.order_surface) && source.order_surface(1).order == 2;
+if identity.profile_id ~= "hellcat_2022_stock" || ~isHellcatSource || ~all(isfield(options, required))
+    error("S12:EngineSoundV12:ResearchOptions", ...
+        "Research controls require the Hellcat identity/source and all option fields.");
+end
+for field = ["cut_minimum", "whine_scale", "induction_scale"]
+    value = options.(field);
+    if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ~isfinite(value) || ...
+            value < 0 || value > 1
+        error("S12:EngineSoundV12:ResearchOptions", "%s must be a scalar in [0,1].", field);
+    end
+    options.(field) = double(value);
+end
+band = options.voicing_rpm_band;
+if ~isnumeric(band) || ~isreal(band) || ~isequal(size(band), [1, 2]) || ...
+        any(~isfinite(band)) || band(1) < 0 || band(2) > 12000 || band(1) >= band(2)
+    error("S12:EngineSoundV12:ResearchOptions", ...
+        "voicing_rpm_band must be a strictly increasing finite RPM row vector.");
+end
+options.voicing_rpm_band = double(band);
+fields = ["mechanical_gain", "mechanical_mod_depth"];
+defaults = [1, 0];
+upperBounds = [1.5, 0.45];
+for index = 1:numel(fields)
+    field = fields(index);
+    if ~isfield(options, field)
+        options.(field) = defaults(index);
+    end
+    value = options.(field);
+    if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ~isfinite(value) || ...
+            value < defaults(index) || value > upperBounds(index)
+        error("S12:EngineSoundV12:ResearchOptions", ...
+            "%s must be a scalar in [%g,%g].", field, defaults(index), upperBounds(index));
+    end
+    options.(field) = double(value);
+end
+if options.mechanical_gain ~= 1 || options.mechanical_mod_depth ~= 0
+    % Ninety-degree event spacing also guarantees nonoverlapping 40-degree pulses.
+    if ~isequal(sort(source.firing_phases_deg), 0:90:630) || ...
+            nnz(source.bank_map == -1) ~= 4 || nnz(source.bank_map == 1) ~= 4
+        error("S12:EngineSoundV12:ResearchOptions", ...
+            "Mechanical controls require eight 90-degree events and four events per bank.");
+    end
+end
+end
+
+function [combustion, orders, induction, mechanical, identityBanks, diagnostics] = applyResearchControls( ...
+        combustion, orders, induction, mechanical, components, rpm, shiftEvent, shiftProgress, ...
+        options, source, cyclePhase)
+x = max(0, min(1, (rpm - options.voicing_rpm_band(1)) / ...
+    (options.voicing_rpm_band(2) - options.voicing_rpm_band(1))));
+activation = x .^ 2 .* (3 - 2 * x);
+whineScale = 1 - (1 - options.whine_scale) * activation;
+inductionScale = 1 - (1 - options.induction_scale) * activation;
+voicingBefore = struct("identity_whine", energy(components.whine), "induction", energy(induction));
+whine = components.whine .* whineScale;
+induction = induction .* inductionScale;
+voicingAfter = struct("identity_whine", energy(whine), "induction", energy(induction));
+
+if shiftEvent == 0
+    cut = ones(size(shiftProgress));
+else
+    cut = 1 - (1 - options.cut_minimum) * sin(pi * shiftProgress) .^ 2;
+end
+cutBefore = struct("combustion", energy(combustion), "orders", energy(orders), ...
+    "identity_exhaust", energy(components.exhaust), "identity_whine", energy(whine), ...
+    "identity_mechanical", energy(components.mechanical), "mechanical", energy(mechanical));
+combustion = combustion .* cut;
+orders = orders .* cut;
+exhaust = components.exhaust .* cut;
+cutAfter = struct("combustion", energy(combustion), "orders", energy(orders), ...
+    "identity_exhaust", energy(exhaust), "identity_whine", energy(whine), ...
+    "identity_mechanical", energy(components.mechanical), "mechanical", energy(mechanical));
+identityBanks = exhaust + whine + components.mechanical;
+diagnostics = struct("cut_multiplier", cut, "cut_min", min(cut), "cut_max", max(cut), ...
+    "voicing_activation", activation, "whine_scale", whineScale, "induction_scale", inductionScale, ...
+    "cut_energy_before", cutBefore, "cut_energy_after", cutAfter, ...
+    "voicing_energy_before", voicingBefore, "voicing_energy_after", voicingAfter);
+if options.mechanical_gain ~= 1 || options.mechanical_mod_depth ~= 0
+    [mechanical, identityMechanical, diagnostics.mechanics] = applyMechanicalControls( ...
+        mechanical, components.mechanical, source, cyclePhase, options);
+    identityBanks = exhaust + whine + identityMechanical;
+end
+end
+
+function [mechanical, identityMechanical, diagnostics] = applyMechanicalControls( ...
+        mechanical, identityMechanical, source, cyclePhase, options)
+envelope = zeros(numel(cyclePhase), 2);
+theta = cyclePhase * 720 / (2 * pi);
+for bank = 1:2
+    phases = source.firing_phases_deg(source.bank_map == 2 * bank - 3);
+    pulses = zeros(size(cyclePhase));
+    for phase = phases
+        delta = mod(theta - phase + 360, 720) - 360;
+        inside = abs(delta) <= 20;
+        pulses(inside) = pulses(inside) + 0.5 * (1 + cos(pi * delta(inside) / 20));
+    end
+    envelope(:, bank) = (pulses - 1 / 9) / (8 / 9);
+end
+multiplier = options.mechanical_gain * (1 + options.mechanical_mod_depth * envelope);
+diagnostics = struct("cycle_phase_rad", cyclePhase, "envelope", envelope, ...
+    "multiplier", multiplier, "source_before", mechanical, "identity_before", identityMechanical, ...
+    "gain", options.mechanical_gain, "depth", options.mechanical_mod_depth);
+mechanical = mechanical .* multiplier;
+identityMechanical = identityMechanical .* multiplier;
+diagnostics.source_after = mechanical;
+diagnostics.identity_after = identityMechanical;
 end
 
