+function [combustion, orders, induction, identityBanks, diagnostics] = applyResearchControls( ...
+        combustion, orders, induction, mechanical, components, rpm, shiftEvent, shiftProgress, options)
+x = max(0, min(1, (rpm - options.voicing_rpm_band(1)) / ...
+    (options.voicing_rpm_band(2) - options.voicing_rpm_band(1))));
+activation = x .^ 2 .* (3 - 2 * x);
+whineScale = 1 - (1 - options.whine_scale) * activation;
+inductionScale = 1 - (1 - options.induction_scale) * activation;
+voicingBefore = struct("identity_whine", energy(components.whine), "induction", energy(induction));
+whine = components.whine .* whineScale;
+induction = induction .* inductionScale;
+voicingAfter = struct("identity_whine", energy(whine), "induction", energy(induction));
